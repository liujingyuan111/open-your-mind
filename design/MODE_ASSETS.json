{
  "schema_version": "1.2",
  "asset_family": "spy-titles-paper-cut",
  "style_reference": {
    "style_id": "spy-titles",
    "title": "60s Spy Title Sequence",
    "repository": "https://github.com/liujingyuan111/lemo-blender-style-library",
    "profile_path": "blender/lemo_style_guard/profiles/spy-titles/"
  },
  "theme_note": "1.2 起模式可按主题提供局部图形与强调色（theme_assets），用于 A/B 视觉比较；主风格未定，此字段不代表冻结新风格。",
  "shared": {
    "seal": "mission-seal.svg",
    "card_shell": "task-card-master.svg",
    "cut_edge": "hand-cut-edge.svg",
    "paper_seam": "paper-seam.svg",
    "paper_shadow": "paper-shadow.svg",
    "paper_texture": "paper-fibre-ink-wear.svg",
    "palette": {
      "ink_black": {"hex":"#1b1714","role":"墨黑：主体轮廓与文字"},
      "paper_cream": {"hex":"#efe4c9","role":"纸奶油：底色与纸片"},
      "hot_ink": {"hex":"#d23a22","role":"热色：强调与危险"},
      "warm_secondary": {"hex":"#e2a52a","role":"暖次色：次级强调/被追逐对象"}
    },
    "rules": {
      "flat_opaque_inks": true,
      "gradients": false,
      "halftone_dots": false,
      "local_space_cut_edges": true,
      "paper_fibre_texture": true,
      "strong_diagonal_composition": true,
      "typography_as_structure": true
    }
  },
  "modes": [
    {
      "mode_id":"verbal",
      "name":"口头描述",
      "accent_role":"hot_ink",
      "icon_asset":"cut-paper-microphone.svg",
      "pattern_asset":"diagonal-cut-composition.svg",
      "rule_title":"描述任务",
      "rule_description":"用语言描述，让队友猜。避开答案和禁止词。",
      "answer_visibility":"performer_only",
      "input_method":"speech",
      "performer_label":"描述者",
      "timer_seconds":60,
      "actions":["correct","skip"],
      "theme_assets": {
        "sketch": { "icon_asset": "doodle-microphone.svg", "accent": "#ff9fb0" }
      }
    },
    {
      "mode_id":"charades",
      "name":"动作表演",
      "accent_role":"warm_secondary",
      "icon_asset":"cut-paper-gesture.svg",
      "pattern_asset":"paper-layer-motion.svg",
      "rule_title":"禁止说话",
      "rule_description":"只能用动作表演，不能说话、写字或亮屏。",
      "answer_visibility":"performer_only",
      "input_method":"gesture",
      "performer_label":"表演者",
      "timer_seconds":60,
      "actions":["correct","skip"],
      "theme_assets": {
        "sketch": { "icon_asset": "doodle-gesture.svg", "accent": "#ffd94d" }
      }
    }
  ]
}
